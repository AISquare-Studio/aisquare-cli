{
  "id": "remote-failure",
  "requirement": "When a remote service fails, the local snapshot stays fully usable and the failure is reported separately in its own ServiceResult.",
  "why_it_matters": "The office is a local tool that also shows remote data. A platform outage must degrade one panel, not the product. The separation is structural: the snapshot never carries a remote field, so there is nothing in it for an outage to poison.",
  "contract_revision": "1.4",
  "documents": [
    {
      "name": "the local snapshot is complete and fresh during the outage",
      "schema": "snapshot.json",
      "value": {
        "v": 1,
        "seq": 4471,
        "taken_at": "2026-09-11T08:41:03+00:00",
        "stale": false,
        "projects": [
          { "id": "prj_ab64", "name": "aisquare-cli", "root": "/Users/arbind/code/aisquare-cli", "frozen": false }
        ],
        "agents": [
          {
            "id": "agt_nova",
            "label": "nova",
            "project_id": "prj_ab64",
            "project_now": "prj_ab64",
            "projects": ["prj_ab64"],
            "role": "coder",
            "origin": "fleet",
            "state": "working",
            "activity": "building",
            "since_s": 0,
            "morale": 60,
            "model": "claude-opus-5",
            "model_family": "opus",
            "up_s": 1380,
            "pane_id": "%14",
            "output_tail": ["› edit api/routes/checkout.py  +41 −9"],
            "last_seen_at": "2026-09-11T08:41:01+00:00",
            "sub": "none",
            "subagents": 0,
            "permission_mode": "default",
            "health": "live"
          }
        ],
        "queue": [],
        "tasks": []
      },
      "assert": [
        { "op": "equal", "pointer": "/stale", "value": false, "note": "the LOCAL poll is fine; stale is about the local poll only" },
        { "op": "length", "pointer": "/agents", "value": 1, "note": "no agent disappears because a remote service is down" },
        { "op": "equal", "pointer": "/agents/0/state", "value": "working" }
      ]
    },
    {
      "name": "the remote read reports its own failure, with no data",
      "schema": "explainability.json",
      "pointer": "/$defs/RunsResult",
      "value": {
        "status": "unavailable",
        "data": null,
        "stale": false,
        "observed_at": null,
        "last_success_at": "2026-09-11T08:12:44+00:00",
        "error": {
          "code": "service_unavailable",
          "detail": "the runs endpoint did not answer within 3 s",
          "retryable": true
        }
      },
      "assert": [
        { "op": "equal", "pointer": "/status", "value": "unavailable" },
        { "op": "equal", "pointer": "/data", "value": null, "note": "explicitly null, and the key is still present" },
        { "op": "equal", "pointer": "/observed_at", "value": null, "note": "nothing was observed, so there is no observation time" },
        { "op": "present", "pointer": "/last_success_at", "note": "…but the UI can still say when it last worked" },
        { "op": "equal", "pointer": "/error/retryable", "value": true, "note": "a READ may be retried; a mutation would not be" }
      ]
    },
    {
      "name": "capabilities agrees, so the UI can grey the panel rather than guess",
      "schema": "services.json",
      "value": {
        "services": [
          { "id": "cli", "status": "ok", "detail": null, "checked_at": "2026-09-11T08:41:03+00:00" },
          { "id": "team_os", "status": "ok", "detail": null, "checked_at": "2026-09-11T08:41:02+00:00" },
          { "id": "explainability", "status": "unavailable", "detail": "no answer within 3 s", "checked_at": "2026-09-11T08:41:03+00:00" },
          { "id": "praxis", "status": "ok", "detail": null, "checked_at": "2026-09-11T08:41:01+00:00" }
        ],
        "checked_at": "2026-09-11T08:41:03+00:00"
      },
      "assert": [
        { "op": "equal", "pointer": "/services/2/status", "value": "unavailable" },
        { "op": "equal", "pointer": "/services/0/status", "value": "ok", "note": "the local service is unaffected" },
        { "op": "length", "pointer": "/services", "value": 4 }
      ]
    }
  ],
  "counterexamples": [
    {
      "name": "the remote outage marked the local snapshot stale",
      "schema": "snapshot.json",
      "value": {
        "v": 1,
        "seq": 4471,
        "taken_at": "2026-09-11T08:41:03+00:00",
        "stale": true,
        "projects": [
          { "id": "prj_ab64", "name": "aisquare-cli", "root": "/Users/arbind/code/aisquare-cli", "frozen": false }
        ],
        "agents": [],
        "queue": [],
        "tasks": []
      },
      "fails_assertion": { "op": "equal", "pointer": "/stale", "value": false },
      "why": "Snapshot.stale means the LOCAL poll failed and this is the previous frame (§3). Setting it because a platform endpoint timed out tells the user their own machine's view is untrustworthy, and — as here — the agent list gets dropped along with it. Local and remote availability are independent."
    },
    {
      "name": "an unavailable result that still serves the last body it had",
      "schema": "explainability.json",
      "pointer": "/$defs/RunsResult",
      "value": {
        "status": "unavailable",
        "data": {
          "items": [],
          "next_cursor": null,
          "partial": false,
          "coverage": null
        },
        "stale": true,
        "observed_at": "2026-09-11T08:12:44+00:00",
        "last_success_at": "2026-09-11T08:12:44+00:00",
        "error": { "code": "service_unavailable", "detail": "timeout", "retryable": true }
      },
      "fails_assertion": { "op": "equal", "pointer": "/data", "value": null },
      "why": "Serving cached rows under status unavailable with partial:false presents half-hour-old data as a complete, current answer. Stale data is only permitted under status ok or partial, where the UI knows to label it."
    }
  ]
}
