#!/bin/sh
# aisquare's Claude Code plugin: run `aisquare hook <event>` for one lifecycle event.
#
# hooks/hooks.json calls this for the six events `aisquare agents connect
# claude-code` writes into settings.json. The work is the CLI's, through the entry
# point those hooks run, so the two routes cannot behave differently:
#
#   1. Stand down when settings.json already runs aisquare for this event. Claude
#      Code runs a plugin's hooks AND the settings.json hooks, so both firing would
#      inject the context twice and capture every prompt twice.
#   2. Else run the aisquare CLI: on PATH, or in ~/.local/bin, where `uv tool
#      install` puts it (a session started from a desktop app may lack it on PATH).
#   3. Else run the pinned release with uvx, so a machine with only uv has memory
#      without an installer.
#   4. Else do nothing, and say so once, at session start.
#
# It never reads stdin, so the child gets the hook payload untouched, and it always
# exits 0: a hook that fails costs its own feature, never the session. aisquare's
# hooks exit 0 themselves; an exit 2 from a broken install would block a prompt.
#
# POSIX sh, like install.sh: no `local`, no `[[`. Checked by shellcheck --shell=sh,
# shfmt -i 4 -ci, dash -n and busybox ash -n (.github/workflows/install.yml).

# The aisquare-cli release uvx runs. The release commit bumps it together with
# pyproject.toml and .claude-plugin/plugin.json; tests/test_claude_plugin.py fails
# when the three disagree. AISQUARE_PLUGIN_FROM replaces the whole requirement
# (a wheel, a path) for testing a build that is not on PyPI yet.
AISQUARE_PLUGIN_VERSION=0.8.0

event=${1:-}
case $event in
    session-start | user-prompt-submit | session-end | stop | notification | stop-failure) ;;
    *) exit 0 ;;
esac

# The hook `agents connect` writes for this event, as it reads in settings.json's
# JSON text, matched the way core.agents._is_aisquare_hook_command matches it: the
# command's first word is a program named aisquare or asq (a path or the bare name,
# plain or in single or double quotes, `.exe` on Windows), or it is `python [-P] -m
# aisquare`; then `hook <event>` ends it, with any options before `hook`. A user's
# own `webhook stop`, `~/bin/my-hook stop` or `echo aisquare hook stop` does not
# match.
_a="'"
# One character of a single-quoted word. An apostrophe in the word is written
# '"'"' ('\"'\"' in JSON text), as shlex.quote does for `agents connect`, or '\''.
_sq="[^$_a]|$_a\\\\\"$_a\\\\\"$_a|$_a\\\\\\\\$_a$_a"
_dq='\"'                   # a double quote, as JSON escapes it
_ws='( |\\t)'              # a space, or a tab as JSON escapes it
_p1="${_a}(($_sq)*/)?"     # '/a path/with spaces/ (or a bare name, quoted)
_p2="[^ \"${_a}\\\\]*/"    # /a/plain/path/
_p3="[^ \"${_a}]*\\\\\\\\" # C:\\a\\windows\\path\\ (JSON escapes \)
_p4="\\\\\"[^\"]*\\\\\\\\" # \"C:\\a quoted\\windows\\path\\
_p5='([^"]|\\")* -m '      # python -P -m, its path quoted or not
_p6='\\"([^"]*/)?'         # \"/a path/with spaces/ (or a bare name, quoted)
# \"$HOME\"/a/path/ and \"${HOME}\"/a/path/, which the hook's shell reads as $HOME/
_p7="\\\\\"[\$]([{]HOME[}]|HOME)\\\\\"$_p2"
_program="($_p1|$_p2|$_p3|$_p4|$_p5|$_p6|$_p7)?(aisquare|asq)(\\.[eE][xX][eE])?(\\\\\"|$_a)?"
_ours="\"command\" *: *\"$_program($_ws+-[^\"]*)?$_ws+hook$_ws+$event$_ws*\""

# The single-quoted word $1 opens with, its quotes gone, into _word. It is quoted
# piece by piece, an apostrophe in it between two pieces, written '"'"' (shlex.quote
# for `agents connect`, uv for a trampoline) or '\'' (see $_sq): read whole, or
# Jane's was read as Jane. $2 is how the text spells a double quote and $3 a
# backslash: as they are in a file, or as JSON escapes them in settings.json's.
_sq_word() {
    _rest=${1#"$_a"}
    _word=
    while :; do
        _word=$_word${_rest%%"$_a"*}
        _rest=${_rest#*"$_a"}
        case $_rest in
            "$2$_a$2$_a"*) _rest=${_rest#"$2$_a$2$_a"} ;;
            "$3$_a$_a"*) _rest=${_rest#"$3$_a$_a"} ;;
            *) break ;;
        esac
        _word=$_word$_a
    done
}

# Whether the program at path $1 can start: an executable file and, when it is a
# script, its #! interpreter is one too. A console script whose environment lost
# its Python (uv python uninstall, a removed Homebrew python@3.x) stays executable
# and fails every run with "bad interpreter", exit 126. Only an absolute
# interpreter is checked; `#!/usr/bin/env python3` and binaries are trusted.
# Where the Python's path has a space or is over 127 bytes, pip and uv write
# #!/bin/sh and exec it from the second line, '''exec' "<python>" "$0" "$@"
# (uv quotes it with '; pip quotes only a path with a space, so a long one is
# bare): that Python is the interpreter checked.
_starts() {
    [ -f "$1" ] && [ -x "$1" ] || return 1
    _first=
    _second=
    {
        IFS= read -r _first
        IFS= read -r _second
    } <"$1" 2>/dev/null
    case $_first in
        '#!'*) ;;
        *) return 0 ;;
    esac
    _interp=${_first#??}
    _interp=${_interp#"${_interp%%[!	 ]*}"}
    _interp=${_interp%%[	 ]*}
    if [ "$_interp" = /bin/sh ]; then
        case $_second in
            "$_a$_a${_a}exec$_a \""*)
                _interp=${_second#*\"}
                _interp=${_interp%%\"*}
                ;;
            "$_a$_a${_a}exec$_a $_a"*)
                _sq_word "${_second#"$_a$_a${_a}exec$_a "}" \" \\
                _interp=$_word
                ;;
            "$_a$_a${_a}exec$_a "*)
                _interp=${_second#"$_a$_a${_a}exec$_a "}
                _interp=${_interp%%[	 ]*}
                ;;
        esac
    fi
    case $_interp in
        /*) [ -f "$_interp" ] && [ -x "$_interp" ] ;;
        *) return 0 ;;
    esac
}

# Whether the program one matching hook ($1, the text grep matched) names can
# start. A hook naming an aisquare that is gone -- the CLI uninstalled after
# `agents connect` -- fails on every event, and standing down beside it would
# leave the session running none. The program is read from between its quotes,
# single or double, else up to the first space or tab. One sh cannot read out of
# the JSON text (an escape other than a \" in single quotes: a Windows or
# non-ASCII path) is trusted, as every match was before this check.
_runnable() {
    _cmd=${1#*\"command\"}
    _cmd=${_cmd#*:}
    _cmd=${_cmd#*\"}
    # "$HOME"/ and "${HOME}"/ are $HOME/, expanded below.
    case $_cmd in
        "$_dq\$HOME$_dq/"* | "$_dq\${HOME}$_dq/"*) _cmd=\$HOME/${_cmd#*"$_dq/"} ;;
    esac
    case $_cmd in
        "$_dq"*)
            _prog=${_cmd#"$_dq"}
            _prog=${_prog%%"$_dq"*}
            ;;
        "$_a"*)
            # JSON's text: a double quote is \" there and a backslash \\.
            _sq_word "$_cmd" "$_dq" "\\\\"
            # Then each \" left is a double quote in the path, as JSON escapes it.
            _cmd=$_word
            _prog=
            while :; do
                case $_cmd in
                    *"$_dq"*) ;;
                    *) break ;;
                esac
                _prog=$_prog${_cmd%%"$_dq"*}\"
                _cmd=${_cmd#*"$_dq"}
            done
            _prog=$_prog$_cmd
            ;;
        *)
            _prog=${_cmd%% *}
            _prog=${_prog%%"\\t"*}
            _prog=${_prog%%\"*}
            ;;
    esac
    # $HOME/ and ${HOME}/ as the hook's own shell expands them, like ~/: read
    # literally, a working hook graded as gone and every event ran twice.
    # shellcheck disable=SC2016
    case $_prog in
        *\\*) return 0 ;;
        \~/*) _prog=$HOME/${_prog#??} ;;
        '$HOME/'*) _prog=$HOME/${_prog#'$HOME/'} ;;
        '${HOME}/'*) _prog=$HOME/${_prog#'${HOME}/'} ;;
    esac
    case $_prog in
        */*) _starts "$_prog" ;;
        *)
            _prog=$(command -v "$_prog" 2>/dev/null) || return 1
            case $_prog in
                /*) _starts "$_prog" ;;
                *) return 0 ;;
            esac
            ;;
    esac
}
_nl='
'

# The settings.json files a session reads its hooks from: the config dir this copy
# of the plugin was installed in (Claude Code keeps it under <dir>/plugins/cache),
# and the one CLAUDE_CONFIG_DIR names, else ~/.claude.
case ${CLAUDE_PLUGIN_ROOT:-} in
    */plugins/cache/*) _installed_in=${CLAUDE_PLUGIN_ROOT%%/plugins/cache/*} ;;
    *) _installed_in= ;;
esac
for _dir in "$_installed_in" "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"; do
    [ -n "$_dir" ] || continue
    # Each match alone (-o), one per line, never the line it is on: in a minified
    # settings.json every hook shares one line, and the program graded must be the
    # one in OUR hook, not the first "command" on that line. Any of ours that can
    # start means settings.json runs aisquare for this event. A missing or
    # unreadable settings.json is grep's error, which is no match.
    _matches=$(grep -o -E "$_ours" "$_dir/settings.json" 2>/dev/null) || continue
    while [ -n "$_matches" ]; do
        _match=${_matches%%"$_nl"*}
        case $_matches in
            *"$_nl"*) _matches=${_matches#*"$_nl"} ;;
            *) _matches= ;;
        esac
        if _runnable "$_match"; then
            exit 0
        fi
    done
done

# The first program named $1 that can start (_starts): on PATH, then where uv
# installs tools. One that cannot is passed over, so the uvx fallback still runs.
_find() {
    _found=$(command -v "$1" 2>/dev/null)
    if [ -n "$_found" ] && _starts "$_found"; then
        printf '%s\n' "$_found"
        return 0
    fi
    for _found in "$HOME/.local/bin/$1" "$HOME/.cargo/bin/$1"; do
        if _starts "$_found"; then
            printf '%s\n' "$_found"
            return 0
        fi
    done
    return 1
}

# The Pythons CI tests aisquare on, as uv reads a request.
_tested='>=3.11,<3.14'

# Where the answer below is kept between one session's events: one line, `ranged` or
# `plain`, then the uv and the range it was asked about.
_answers=${XDG_CACHE_HOME:-$HOME/.cache}/aisquare
_answer_file=$_answers/plugin-tested-python

# Whether uv has a Python in $_tested, or may fetch one: `uv python find` answers
# for the installed ones, and `uv run` fetches one wherever uv's python-downloads
# allows it (Fedora's packaged uv sets "manual"). Asked of the uv beside uvx, else
# the first that can start; with none to ask, uvx is given the range as it always
# was. Neither question reads stdin or prints, so the payload stays the hook's.
# Asked at session start, and on another event only when no answer is kept for this
# uv: every prompt paid for one or two uv runs, and an offline `uv run` waits for
# its download to time out (round 19 of #257). Read with builtins, for no process.
_has_tested_python() {
    _uv=${_runner%/*}/uv
    _starts "$_uv" || _uv=$(_find uv) || return 0
    _key="$_uv $_tested"
    if [ "$event" != session-start ]; then
        _line=
        IFS= read -r _line 2>/dev/null <"$_answer_file"
        if [ "${_line#* }" = "$_key" ]; then
            case $_line in
                "ranged "*) return 0 ;;
                "plain "*) return 1 ;;
            esac
        fi
    fi
    if "$_uv" python find --system "$_tested" </dev/null >/dev/null 2>&1 ||
        "$_uv" run --no-project --python "$_tested" python -c '' </dev/null >/dev/null 2>&1; then
        _answer=ranged
    else
        _answer=plain
    fi
    [ -d "$_answers" ] || mkdir -p "$_answers" 2>/dev/null
    printf '%s %s\n' "$_answer" "$_key" 2>/dev/null >"$_answer_file"
    [ "$_answer" = ranged ]
}

if _runner=$(_find aisquare); then
    "$_runner" hook "$event"
    _status=$?
elif _runner=$(_find uvx); then
    _from=${AISQUARE_PLUGIN_FROM:-aisquare-cli==$AISQUARE_PLUGIN_VERSION}
    # A Python CI tests where uv has one or may fetch one, else whatever uv has:
    # asked for the range with neither, uvx fails. Decided BEFORE the one run, as a
    # retry cannot be: a run that failed may be aisquare's own, which has read the
    # payload and may have printed, so a second would get no payload and print twice.
    if _has_tested_python; then
        "$_runner" --python "$_tested" --from "$_from" aisquare hook "$event"
    else
        "$_runner" --from "$_from" aisquare hook "$event"
    fi
    _status=$?
else
    if [ "$event" = session-start ]; then
        printf '%s\n' '{"systemMessage": "aisquare: neither the aisquare CLI nor uv was found, so this session has no aisquare memory. Install uv: https://docs.astral.sh/uv/"}'
    fi
    exit 0
fi

if [ "$_status" -ne 0 ] && [ "$event" = session-start ]; then
    printf '{"systemMessage": "aisquare: its session-start hook failed (exit %s), so this session has no aisquare memory."}\n' "$_status"
fi
exit 0
