{
  "id": "team-os-peer-down",
  "requirement": "A stopped Team OS peer makes its views unavailable and nothing else; CLI fleet agents and project context are untouched.",
  "why_it_matters": "Team OS is a separate local HTTP peer, and on this machine it is frequently not running at all. Its roster is not the Office fleet — the two id namespaces are never joined. A peer being down is a first-class, ordinary state, not an error path.",
  "contract_revision": "1.4",
  "documents": [
    {
      "name": "meta: the peer did not answer",
      "schema": "team-os.json",
      "pointer": "/$defs/MetaResult",
      "value": {
        "status": "unavailable",
        "data": {
          "source": "team_os",
          "available": false,
          "views": [],
          "display_name": null,
          "peer_revision": null
        },
        "stale": false,
        "observed_at": "2026-09-11T08:41:03+00:00",
        "last_success_at": null,
        "error": {
          "code": "service_unavailable",
          "detail": "the Team OS peer is not listening on the configured port",
          "retryable": true
        }
      },
      "assert": [
        { "op": "equal", "pointer": "/data/available", "value": false },
        { "op": "length", "pointer": "/data/views", "value": 0, "note": "an empty allow-list, not an error" },
        { "op": "equal", "pointer": "/last_success_at", "value": null, "note": "it has never answered in this session" },
        { "op": "equal", "pointer": "/data/source", "value": "team_os", "note": "still labelled, so it can never be mistaken for CLI data" }
      ]
    },
    {
      "name": "a named view is unavailable, with no data",
      "schema": "team-os.json",
      "pointer": "/$defs/ViewResult",
      "value": {
        "status": "unavailable",
        "data": null,
        "stale": false,
        "observed_at": null,
        "last_success_at": null,
        "error": { "code": "service_unavailable", "detail": "peer not reachable", "retryable": true }
      },
      "assert": [
        { "op": "equal", "pointer": "/data", "value": null },
        { "op": "equal", "pointer": "/status", "value": "unavailable" }
      ]
    },
    {
      "name": "the CLI fleet is completely unaffected",
      "schema": "snapshot.json",
      "value": {
