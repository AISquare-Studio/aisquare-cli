      "errors": ["/features: fewer than 11 items"],
      "why": "team_os.views and platform.teach were left out instead of reported as disabled. A client cannot tell 'this back-end cannot do it' from 'this back-end is older than the feature', so it either hides a working control or offers a dead one."
    },
    {
      "name": "a 202 Operation handed to a client that never sent the handshake",
      "schema": "operation.json",
      "value": {
        "operation_id": "op_01hq9m2v",
        "kind": "prompt.resolve",
        "target": { "agent_id": "agt_ember" },
        "status": "queued",
        "submitted_at": "2026-09-11T08:41:03+00:00",
        "updated_at": "2026-09-11T08:41:03+00:00",
        "receipt": null,
        "error": null
      },
      "fails_assertion": { "op": "present", "pointer": "/receipt" },
      "why": "This document is well-formed and would be returned with 202. A v1.3 client has no notion of 202-versus-200 and reads the body as a Receipt: `delivered` is absent, `detail` is absent, and the UI prints an empty confirmation under the button for work that has not happened. The handshake exists so this body can never reach that client."
    }
