        "error": null
      },
      "assert": [
        { "op": "equal", "pointer": "/data/team_os", "value": null, "note": "the peer half is absent…" },
        { "op": "length", "pointer": "/data/cli/sections", "value": 1, "note": "…and the CLI half is untouched" },
        { "op": "equal", "pointer": "/data/cli/source", "value": "cli", "note": "separately labelled sources, never merged" },
        { "op": "equal", "pointer": "/status", "value": "partial" }
      ]
    }
  ],
  "counterexamples": [
    {
      "name": "the peer outage emptied the fleet",
      "schema": "snapshot.json",
      "value": {
        "v": 1,
        "seq": 4471,
        "taken_at": "2026-09-11T08:41:03+00:00",
        "stale": true,
        "projects": [
          { "id": "prj_ab64", "name": "aisquare-cli", "root": "/Users/arbind/code/aisquare-cli", "frozen": false }
        ],
        "agents": [],
        "queue": [],
        "tasks": []
      },
      "fails_assertion": { "op": "gte", "pointer": "/agents", "value": 1 },
      "why": "Every fleet agent vanished from the office because a separate local peer stopped answering. The Team OS roster and the Office fleet are different things from different sources; one cannot empty the other."
    },
    {
      "name": "a roster entry carrying an Office fleet id",
      "schema": "team-os.json",
      "pointer": "/$defs/TeamOSRosterEntry",
      "value": {
        "source": "team_os",
        "peer_local_id": "agt_nova",
        "label": "nova",
        "summary": null,
        "agent_id": "agt_nova"
      },
      "errors": ["/agent_id: unexpected property"],
      "why": "A roster row is peer-local. Adding an Office agent id would silently assert a join between two id namespaces that are never correlated, and the UI would start treating a peer entry as a controllable fleet agent."
    },
    {
      "name": "an arbitrary view name reaching the peer",
      "schema": "team-os.json",
      "pointer": "/$defs/ViewName",
      "value": "../../etc/passwd",
      "errors": ["/: \"../../etc/passwd\" does not match /^[a-z0-9][a-z0-9_-]{0,63}$/"],
      "why": "View names are an allow-list the peer advertised, not a path. The pattern is the last line of defence if a caller ever forwards a browser-supplied name."
    }
  ]
}
