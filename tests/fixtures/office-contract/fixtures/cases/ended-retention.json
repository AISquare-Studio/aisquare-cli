{
  "id": "ended-retention",
  "requirement": "An ended row stays in Snapshot.agents for 10 minutes but is never in the queue; at the deadline agent.left drops it.",
  "why_it_matters": "data-contract.md §7 and §13.8. A crash, a kill and a clean exit used to look identical and leave nothing to act on. The retained row is what lets the office show an agent leaving and offer Respawn — but it is finished, so it cannot hold a place in the queue for a question nobody can answer.",
  "contract_revision": "1.3",
  "documents": [
    {
      "name": "the pane died first",
      "schema": "event.json",
      "value": { "kind": "agent.health", "agent_id": "agt_wren", "health": "dead", "exit_status": 1 },
      "assert": [{ "op": "equal", "pointer": "/health", "value": "dead" }]
    },
    {
      "name": "then agent.ended — the row is retained, not removed",
      "schema": "event.json",
      "value": {
        "kind": "agent.ended",
        "agent_id": "agt_wren",
        "ended_reason": "crash",
        "exit_status": 1,
        "output_tail": ["Traceback (most recent call last):", "RuntimeError: worker died"]
      },
      "assert": [
        { "op": "equal", "pointer": "/ended_reason", "value": "crash" },
        { "op": "equal", "pointer": "/exit_status", "value": 1 }
      ]
    },
    {
      "name": "within retention: present in agents, absent from queue",
      "schema": "snapshot.json",
      "value": {
        "v": 1,
        "seq": 4610,
        "taken_at": "2026-09-11T08:45:00+00:00",
        "stale": false,
        "projects": [
          { "id": "prj_ab64", "name": "aisquare-cli", "root": "/Users/arbind/code/aisquare-cli", "frozen": false }
        ],
        "agents": [
          {
            "id": "agt_wren",
            "label": "wren",
            "project_id": "prj_ab64",
            "project_now": "prj_ab64",
            "projects": ["prj_ab64"],
            "role": "coder",
            "origin": "fleet",
            "state": "ended",
            "activity": "idle",
            "since_s": 0,
            "morale": 50,
            "model": "claude-sonnet-5",
            "model_family": "sonnet",
            "up_s": 900,
            "pane_id": "%31",
            "task_id": "tsk_02be",
            "output_tail": ["Traceback (most recent call last):", "RuntimeError: worker died"],
            "last_seen_at": "2026-09-11T08:44:12+00:00",
            "sub": "none",
            "subagents": 0,
            "permission_mode": "default",
            "health": "dead",
            "ended_at": "2026-09-11T08:44:12+00:00",
            "ended_reason": "crash",
            "exit_status": 1
          }
        ],
        "queue": [],
        "tasks": [
          { "id": "tsk_02be", "project_id": "prj_ab64", "title": "Checkout intent", "status": "doing", "needs": [], "claimed_by": "agt_wren" }
        ]
      },
      "assert": [
        { "op": "equal", "pointer": "/agents/0/state", "value": "ended" },
        { "op": "equal", "pointer": "/agents/0/ended_reason", "value": "crash" },
        { "op": "present", "pointer": "/agents/0/ended_at" },
        { "op": "equal", "pointer": "/agents/0/since_s", "value": 0, "note": "an ended row is not waiting for anyone" },
        { "op": "not_contains", "pointer": "/queue", "value": "agt_wren", "note": "the whole rule" },
        { "op": "length", "pointer": "/queue", "value": 0 },
        { "op": "equal", "pointer": "/agents/0/task_id", "value": "tsk_02be", "note": "the row remembers its task so Respawn can take it up again" }
      ]
    },
    {
      "name": "at the deadline: agent.left, and the row is gone",
      "schema": "event.json",
      "value": { "kind": "agent.left", "agent_id": "agt_wren", "reason": "ended" },
      "assert": [{ "op": "equal", "pointer": "/reason", "value": "ended" }]
    },
    {
      "name": "after the deadline",
      "schema": "snapshot.json",
      "value": {
        "v": 1,
        "seq": 4640,
        "taken_at": "2026-09-11T08:55:00+00:00",
        "stale": false,
        "projects": [
          { "id": "prj_ab64", "name": "aisquare-cli", "root": "/Users/arbind/code/aisquare-cli", "frozen": false }
        ],
        "agents": [],
        "queue": [],
        "tasks": [
          { "id": "tsk_02be", "project_id": "prj_ab64", "title": "Checkout intent", "status": "doing", "needs": [] }
        ]
      },
      "assert": [
        { "op": "length", "pointer": "/agents", "value": 0, "note": "dropped ten minutes after it ended" },
        { "op": "absent", "pointer": "/tasks/0/claimed_by", "note": "and the claim was released" }
      ]
    }
  ],
  "counterexamples": [
    {
      "name": "the ended row kept its place in the queue",
      "schema": "snapshot.json",
      "value": {
        "v": 1,
        "seq": 4610,
        "taken_at": "2026-09-11T08:45:00+00:00",
        "stale": false,
        "projects": [
          { "id": "prj_ab64", "name": "aisquare-cli", "root": "/Users/arbind/code/aisquare-cli", "frozen": false }
        ],
        "agents": [
          {
            "id": "agt_wren",
            "label": "wren",
            "project_id": "prj_ab64",
            "project_now": "prj_ab64",
            "projects": ["prj_ab64"],
            "role": "coder",
            "origin": "fleet",
            "state": "ended",
            "activity": "idle",
            "since_s": 0,
            "morale": 50,
            "model_family": "sonnet",
            "up_s": 900,
            "pane_id": "%31",
            "output_tail": [],
            "last_seen_at": "2026-09-11T08:44:12+00:00",
            "sub": "none",
            "subagents": 0,
            "permission_mode": "default",
            "health": "dead",
            "ended_at": "2026-09-11T08:44:12+00:00",
            "ended_reason": "crash"
          }
        ],
        "queue": ["agt_wren"],
        "tasks": []
      },
      "fails_assertion": { "op": "not_contains", "pointer": "/queue", "value": "agt_wren" },
      "why": "A dead agent sits at the head of the CEO queue holding a question that can never be answered — every answer attempt returns no_pane, and the real blockers behind it are pushed down. §7 restricts the queue to attention and waiting for exactly this reason."
    },
    {
      "name": "an ended reason outside the closed set",
      "schema": "event.json",
      "value": { "kind": "agent.ended", "agent_id": "agt_wren", "ended_reason": "vanished", "output_tail": [] },
      "errors": ["/ended_reason: expected one of \"exit\", \"clear\", \"logout\", \"crash\", \"killed\", \"pruned\", \"other\", got \"vanished\""],
      "why": "The six reasons plus `other` are what the office can distinguish and act on; a seventh invented value would render as an unknown badge with no Respawn affordance."
    }
  ]
}
